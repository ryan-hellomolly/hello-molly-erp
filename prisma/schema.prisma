// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum FactoryStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseOwnership {
  HELLO_MOLLY
  THIRD_PARTY
  FACTORY
  SUPPLIER
}

enum WarehouseLocationStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum ReferenceType {
  SIZE
  UNIT
  CURRENCY
  TRADE_TERM
  SETTLEMENT_METHOD
  INVOICE_TYPE
  SAMPLE_TYPE
  EXPENSE_TYPE
  SALES_CHANNEL
}

enum TemplateType {
  SAMPLE
  MEASUREMENT
  CONSTRUCTION
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  name           String
  normalizedName String
  countryCode    String         @db.Char(2)
  salesChannel   String?
  ownerName      String?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([normalizedName, countryCode])
  @@index([name])
  @@index([status])
}

model Supplier {
  id             String                  @id @default(uuid()) @db.Uuid
  code           String                  @unique
  name           String
  normalizedName String
  countryCode    String                  @db.Char(2)
  category       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  status         SupplierStatus          @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  certifications SupplierCertification[]

  @@unique([normalizedName, countryCode])
  @@index([name])
  @@index([status])
}

model SupplierCertification {
  id                String    @id @default(uuid()) @db.Uuid
  supplierId        String    @db.Uuid
  certificationType String
  certificateNumber String?
  issuedBy          String?
  validFrom         DateTime? @db.Date
  expiresAt         DateTime  @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, certificationType, certificateNumber])
  @@index([supplierId, expiresAt])
  @@index([expiresAt])
}

model Factory {
  id             String        @id @default(uuid()) @db.Uuid
  code           String        @unique
  name           String
  normalizedName String
  countryCode    String        @db.Char(2)
  city           String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  capabilities   String[]      @default([])
  status         FactoryStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([normalizedName, countryCode])
  @@index([name])
  @@index([status])
}

model Warehouse {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  name        String
  countryCode String              @db.Char(2)
  city        String?
  address     String?
  ownership   WarehouseOwnership
  ownerName   String?
  status      WarehouseStatus     @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  locations   WarehouseLocation[]

  @@index([name])
  @@index([ownership, status])
}

model WarehouseLocation {
  id          String                  @id @default(uuid()) @db.Uuid
  warehouseId String                  @db.Uuid
  code        String
  name        String?
  zone        String?
  status      WarehouseLocationStatus @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  warehouse   Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@index([warehouseId, status])
}

model ReferenceValue {
  id            String        @id @default(uuid()) @db.Uuid
  type          ReferenceType
  code          String
  nameEn        String
  nameZh        String
  category      String?
  symbol        String?
  descriptionEn String?
  descriptionZh String?
  sortOrder     Int           @default(0)
  decimalPlaces Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([type, code])
  @@index([type, active, sortOrder])
}

model DeliveryAddress {
  id        String   @id @default(uuid()) @db.Uuid
  address   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CashierAccount {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  routingNumber String?
  accountNumber String
  currency      String
  address       String?
  notes         String?
  qrCodeUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([accountNumber, currency])
  @@index([name])
}

model TemplateMaster {
  id          String         @id @default(uuid()) @db.Uuid
  type        TemplateType
  code        String
  version     Int
  nameEn      String
  nameZh      String
  description String?
  content     Json
  status      TemplateStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([type, code, version])
  @@index([type, status, code])
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  displayName         String
  passwordHash        String
  locale              String               @default("en-AU")
  status              UserStatus           @default(ACTIVE)
  tokenVersion        Int                  @default(0)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  userRoles           UserRole[]
  auditEvents         AuditEvent[]         @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]

  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  nameEn      String
  nameZh      String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  rotatedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  occurredAt DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
}
