# Application
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional: set locally before `npm run db:seed`; never commit a real password.
SEED_ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_DB=hello_molly_erp
POSTGRES_USER=hello_molly
POSTGRES_PASSWORD=hello_molly_local
DATABASE_URL=postgresql://hello_molly:hello_molly_local@localhost:55432/hello_molly_erp?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:56379

# S3-compatible local object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_BUCKET=hello-molly-erp-local
S3_ACCESS_KEY=hello_molly
S3_SECRET_KEY=hello_molly_local_storage

# Local mail capture
SMTP_HOST=localhost
SMTP_PORT=11025
MAIL_FROM=erp-local@hellomolly.com.au
